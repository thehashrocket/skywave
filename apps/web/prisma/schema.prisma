generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A saved frequency, optionally pinned to a specific receiver.
model Preset {
  id           String   @id @default(cuid())
  name         String
  freqKhz      Float
  mode         String
  receiverHost String?
  receiverPort Int?
  createdAt    DateTime @default(now())

  @@index([freqKhz])
}

/// One listener's answer to "Did you hear it?" (issue #60): a known transmitter
/// on a receiver and frequency at a UTC time, heard or not. Ground truth for
/// propagation forecasts and per-band receiver ranking.
///
/// Holds no IP address, name or callsign: `listenerId` is a random id the
/// browser keeps, only so the rate limits in routers/reports.ts work.
model ReceptionReport {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  listenerId   String
  receiverHost String
  receiverPort Int
  freqKhz      Float
  mode         String
  /// "eibi" for a station in the EiBi schedule, "beacon" for a beacon (#59).
  /// Text rather than an enum, so adding a kind needs no migration.
  txKind       String
  /// The EiBi station, or the beacon's callsign.
  txName       String
  /// EiBi language/target codes ("E/NAm"), or the beacon's band.
  txDetail     String?
  /// Beacons only: the UTC start (ms since the epoch) of the 10 s slot the
  /// prompt asked about, which the server checked against the schedule.
  slotStartMs  BigInt?
  /// "heard" | "not_heard" | "no_open"
  outcome      String
  comment      String?
  /// How Pick best chose this receiver (issue #61; lib/pick-context.ts).
  /// All null for a hand-picked receiver, a page from before this column,
  /// or context the server couldn't vouch for (the answer is kept anyway).
  /// When it tuned the receiver, ms since the epoch by the page's estimate of
  /// the server's clock (version 5: good to about 2 s; version 6: to the
  /// measurement's error, under 1.5 s on an ordinary visit).
  pickedAtMs   BigInt?
  /// "beacon" | "listen" | "link" | "drawer" | "better"; text, like txKind.
  pickSource   String?
  /// Place in the ranked list the run was given, from 0.
  rankPos      Int?
  /// The ranked list's first 10 receivers, "host:port", best first.
  candidates   Json?
  /// How many of `candidates` were on the server's public list when the answer
  /// arrived. Fewer than all: a forged key, or a receiver that left the list
  /// since the pick. Null without context, and on rows from before this column.
  /// A full count proves nothing: a forger can name real listed receivers.
  candidatesListed Int?
  /// The receiver's position, listed SNR and users at pick time.
  pickLat      Float?
  pickLon      Float?
  pickSnr      Float?
  pickUsers    Int?
  /// Which rules made the context (PICK_CONTEXT_VERSION). Null with context
  /// present: the page sent no version. Saved before PR #74's deploy
  /// (2026-11-19 02:52:57 UTC), that's PR #73's first rules; saved after it,
  /// a tab opened before the deploy, whose context passed the newer server
  /// checks. The replay splits null rows by createdAt. 2 saved after the
  /// round 2 deploy, 3 after the monotonic clock's, 4 after round 3's, or 5
  /// after the scheduled clock's, is likewise a tab opened before it. The page sends this and the server
  /// can't check it; createdAt against the deploy times posted on #61 says
  /// which server rules took the row.
  pickVersion  Int?
  /// Beacons only (#69): NCDXF's official status for the beacon when the
  /// answer arrived, "OK" or "OFF", from the server's cached copy of
  /// IBPStatus.csv (an unknown status there counts as "OK"). Null for a
  /// station, when the server hadn't fetched the file yet, or on rows from
  /// before this column. The list can lag the air by days, and a beacon off
  /// for a contest still reads "OK".
  beaconStatus String?
  /// Beacons only (#69 v2): how many times the Reverse Beacon Network's
  /// skimmers spotted this beacon (mode "NCDXF B") on `rbnDay`, the last whole
  /// UTC day the server had counted when the answer arrived (usually
  /// yesterday). 0 with a "heard" answer: heard back on the air. Null for a
  /// station, when the server had no count yet, or on older rows.
  rbnSpots     Int?
  /// The UTC day ("YYYY-MM-DD") `rbnSpots` counts.
  rbnDay       String?

  @@index([receiverHost, receiverPort, freqKhz])
  @@index([listenerId, createdAt])
}

/// One UTC day of the Reverse Beacon Network's IBP spots (#69 v2): how many
/// times its skimmers spotted each beacon. Fetched once, by whichever server
/// first needs the day after 01:00 UTC, from RBN's daily file.
model RbnBeaconDay {
  /// "YYYY-MM-DD", UTC.
  day       String   @id
  createdAt DateTime @default(now())
  /// All NCDXF B spots of the 18 beacons that day. Under 2,000
  /// (RBN_MIN_DAY_SPOTS) is RBN's own outage: nothing is marked quiet.
  total     Int
  /// [{ call, spots }] for all 18 beacons, in transmission order.
  beacons   Json
}
