generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A saved frequency, optionally pinned to a specific receiver.
model Preset {
  id           String   @id @default(cuid())
  name         String
  freqKhz      Float
  mode         String
  receiverHost String?
  receiverPort Int?
  createdAt    DateTime @default(now())

  @@index([freqKhz])
}

/// One listener's answer to "Did you hear it?" (issue #60): a known transmitter
/// on a receiver and frequency at a UTC time, heard or not. Ground truth for
/// propagation forecasts and per-band receiver ranking.
///
/// Holds no IP address, name or callsign: `listenerId` is a random id the
/// browser keeps, only so the rate limits in routers/reports.ts work.
model ReceptionReport {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  listenerId   String
  receiverHost String
  receiverPort Int
  freqKhz      Float
  mode         String
  /// "eibi" for a station in the EiBi schedule, "beacon" for a beacon (#59),
  /// "signal" for a signal station (#101, lib/signal-stations.ts).
  /// Text rather than an enum, so adding a kind needs no migration.
  txKind       String
  /// The EiBi station, the beacon's callsign, or the signal station's slug.
  txName       String
  /// EiBi language/target codes ("E/NAm"), the beacon's band, or the signal
  /// station's channel in kHz.
  txDetail     String?
  /// Beacons: the UTC start (ms since the epoch) of the 10 s slot the prompt
  /// asked about, which the server checked against the schedule. Numbers
  /// stations (signal stations on Priyom's schedule): the start of the
  /// transmission asked about, checked against the server's copy of Priyom's.
  /// Null otherwise.
  slotStartMs  BigInt?
  /// "heard" | "not_heard" | "no_open"
  outcome      String
  comment      String?
  /// How Pick best chose this receiver (issue #61; lib/pick-context.ts).
  /// All null for a hand-picked receiver, a page from before this column,
  /// or context the server couldn't vouch for (the answer is kept anyway).
  /// When it tuned the receiver, ms since the epoch by the page's estimate of
  /// the server's clock (version 5: good to about 2 s; version 6: to the
  /// measurement's error, under 1.5 s on an ordinary visit).
  pickedAtMs   BigInt?
  /// "beacon" | "listen" | "link" | "drawer" | "better" | "search" | "ghostnet" | "browse" | "signal"; text, like txKind.
  pickSource   String?
  /// Place in the ranked list the run was given, from 0.
  rankPos      Int?
  /// The ranked list's first 10 receivers, "host:port", best first.
  candidates   Json?
  /// How many of `candidates` were on the server's public list when the answer
  /// arrived. Fewer than all: a forged key, or a receiver that left the list
  /// since the pick. Null without context, and on rows from before this column.
  /// A full count proves nothing: a forger can name real listed receivers.
  candidatesListed Int?
  /// The receiver's position, listed SNR and users at pick time.
  pickLat      Float?
  pickLon      Float?
  pickSnr      Float?
  pickUsers    Int?
  /// Which rules made the context (PICK_CONTEXT_VERSION). Null with context
  /// present: the page sent no version. Saved before PR #74's deploy
  /// (2026-11-19 02:52:57 UTC), that's PR #73's first rules; saved after it,
  /// a tab opened before the deploy, whose context passed the newer server
  /// checks. The replay splits null rows by createdAt. Each later version
  /// (2 to 10, what each one changed: PICK_CONTEXT_VERSION's docblock in
  /// src/lib/pick-context.ts) saved after the next one's deploy is likewise a
  /// tab opened before it. The page sends this and the server can't check it;
  /// createdAt against the deploy times posted on #61 says which server rules
  /// took the row.
  pickVersion  Int?
  /// Beacons only (#69): NCDXF's official status for the beacon when the
  /// answer arrived, "OK" or "OFF", from the server's cached copy of
  /// IBPStatus.csv (an unknown status there counts as "OK"). Null for a
  /// station, when the server hadn't fetched the file yet, or on rows from
  /// before this column. The list can lag the air by days, and a beacon off
  /// for a contest still reads "OK".
  beaconStatus String?
  /// Beacons only (#69 v2): how many times the Reverse Beacon Network's
  /// skimmers spotted this beacon (mode "NCDXF B") on `rbnDay`, the last whole
  /// UTC day the server had counted when the answer arrived (usually
  /// yesterday). 0 with a "heard" answer: heard back on the air. Null for a
  /// station, when the server had no count yet, or on older rows.
  rbnSpots     Int?
  /// The UTC day ("YYYY-MM-DD") `rbnSpots` counts.
  rbnDay       String?
  /// EiBi answers only (#72): every transmitter the named station(s) could
  /// have been sent from, at the latest minute of the grace window each was
  /// on the air, from this server's schedule and EiBi's site table
  /// (lib/eibi-sites.ts). A list of {key, coords: [[lat, lon], ...]} (coords
  /// empty when EiBi lists none; a key with several coords is a group of
  /// transmitters), or {key: null, country, coords: []} when EiBi doesn't say
  /// which site. Null for beacons, rows from before this column, or when the
  /// lookup failed (logged; the answer is kept).
  txSites      Json?
  /// EiBi answers only (#115 review, owner D1/D2): which rules chose the
  /// station(s) the question asked about (ASK_RULE_VERSION in
  /// src/lib/reception.ts). Null: a page from before this column (EiBi's first
  /// listing was asked about), a beacon, or a value the server couldn't read.
  /// 1: with more than 3 stations on the frequency, the one aimed at
  /// `askRegion` was asked about; and with a region, a station listed more than
  /// once in one language (several sites) gets txDetail from its row aimed
  /// there, on any frequency. The page's word; the server can't check it.
  askRule      Int?
  /// The receiver's broad region ("na", "eu", "as", "af", "me", "oc", "la")
  /// the stations were ranked by, from its listed position. Null with askRule
  /// 1: no position was known, so EiBi's order was kept.
  askRegion    String?

  @@index([receiverHost, receiverPort, freqKhz])
  @@index([listenerId, createdAt])
}

model RbnSkimmerDay {
  /// "YYYY-MM-DD", UTC: the day the list was fetched. RBN publishes only a
  /// live list of skimmers (seen in the last 7 days) with no history, so the
  /// #61 replay joins each day's spots to the nearest saved list.
  day       String   @id
  createdAt DateTime @default(now())
  /// When the list was fetched; each skimmer's lastSeen is measured from it.
  fetchedAt DateTime
  /// How many skimmers the list held.
  total     Int
  /// [{ call, grid (upper-case Maidenhead, or null when RBN's isn't one),
  /// bands, lastSeen (ms since the epoch) }], as lib/rbn.ts parses them.
  skimmers  Json
  /// The page exactly as RBN served it, gzipped, so any day can be parsed
  /// again after a parser fix or for fields not kept above.
  raw       Bytes
}

/// Every page RBN served that wasn't saved as a day (#61): refused by the
/// parser or the 80% rule, or parsed but not written. Kept so the day can be
/// parsed again after a fix. A refusal doesn't mark the day done, so the next
/// cron run still tries; once a run saves the day, RbnSkimmerDay is its record
/// and its refusals here are only history.
model RbnSkimmerRefusal {
  /// "YYYY-MM-DD", UTC: the day the page was fetched.
  day       String
  fetchedAt DateTime
  /// Why it wasn't saved.
  reason    String
  /// How many skimmers it parsed to; null when it didn't parse.
  total     Int?
  /// The page exactly as RBN served it, gzipped.
  raw       Bytes

  @@id([day, fetchedAt])
}

/// One UTC day of the Reverse Beacon Network's IBP spots (#69 v2): how many
/// times its skimmers spotted each beacon. Fetched once, by whichever server
/// first needs the day after 01:00 UTC, from RBN's daily file.
model RbnBeaconDay {
  /// "YYYY-MM-DD", UTC.
  day       String   @id
  createdAt DateTime @default(now())
  /// All NCDXF B spots of the 18 beacons that day. Under 2,000
  /// (RBN_MIN_DAY_SPOTS) is RBN's own outage: nothing is marked quiet.
  total     Int
  /// [{ call, spots }] for all 18 beacons, in transmission order.
  beacons   Json
}
