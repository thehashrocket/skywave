DATABASE_URL=postgresql://skywave:skywave@localhost:5432/skywave
# Where the browser finds the Python radio service
NEXT_PUBLIC_RADIO_WS_URL=ws://localhost:8765/ws
# Must match RADIO_TOKEN in apps/radio/.env if you set one
NEXT_PUBLIC_RADIO_TOKEN=
# Optional password for the whole app (HTTP Basic auth, any username).
# Set it whenever the app is reachable from the internet: it also guards the
# JS bundle that carries NEXT_PUBLIC_RADIO_TOKEN.
APP_PASSWORD=
