# Comma-separated browser origins allowed to connect (your Next.js app URL)
ALLOWED_ORIGINS=http://localhost:3000
# Shared secret; set NEXT_PUBLIC_RADIO_TOKEN in the web app to match.
# Optional while ALLOWED_ORIGINS is localhost only; the service refuses to
# start without it once any other origin is allowed.
RADIO_TOKEN=
# Simultaneous listeners. Each one uses a channel on someone's volunteer Kiwi.
MAX_SESSIONS=2
# Drop a session after this many minutes: at least 1, or "inf" for no limit.
MAX_SESSION_MINUTES=60
# Close a browser's socket after this many minutes with nothing playing and no
# message from it (the page reconnects on its next tune): at least 1, or "inf".
IDLE_SOCKET_MINUTES=10
# Browser sockets one public address may hold open at once (each tab uses one;
# IPv6 counts by /64). People behind one shared address (carrier NAT, an office)
# share it. Private addresses aren't counted; behind a reverse proxy, set
# FORWARDED_ALLOW_IPS so this sees real users.
MAX_SOCKETS_PER_IP=8
# Only turn on if you're pointing at a Kiwi on your own LAN
ALLOW_PRIVATE_HOSTS=false
# Behind a reverse proxy: the proxy's address as this service sees it, so the
# per-user lookup limit and MAX_SOCKETS_PER_IP see real user IPs (read by uvicorn). Never "*" while
# the service's port is reachable without the proxy.
# FORWARDED_ALLOW_IPS=172.17.0.1
KIWI_IDENT=skywave
KIWI_AGC=true
